{
  "name": "@appoutlet/cc-statusline",
  "version": "2.0.6",
  "description": "Rich multi-line status line for Claude Code — context, model, git and plan-usage bars",
  "keywords": [
    "claude",
    "claude-code",
    "statusline",
    "cli"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MessiasLima/cc-statusline.git"
  },
  "bin": {
    "cc-statusline": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/cli.ts src/update.ts --bundle --minify --platform=node --format=cjs --target=node18 --banner:js=\"#!/usr/bin/env node\" --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
